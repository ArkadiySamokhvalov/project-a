script = ExtResource("1_pbxev")
skill_name = "Установка барьера"
description = "Ставит энергетический заслон на любое ребро клетки в радиусе 2 клеток (живет 2 раунда или до столкновения). Останавливает движение и отталкивает пытающегося пройти врага на 1 клетку назад."
